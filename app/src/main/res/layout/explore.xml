<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/navy_primary"
    android:fitsSystemWindows="false">


    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:layout_marginBottom="72dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/navy_primary"
                android:fitsSystemWindows="true">

                <!-- Search Bar + Profile Picture -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="16dp"
                    android:gravity="center_vertical"
                    android:background="@color/navy_primary">

                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="12dp"
                        app:cardCornerRadius="25dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="@color/navy_chip">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:src="@drawable/ic_search"
                                android:tint="@color/muted_text"
                                tools:ignore="UseAppTint"/>

                            <EditText
                                android:id="@+id/searchEditText"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="10dp"
                                android:background="@null"
                                android:hint="Search missing persons…"
                                android:textColorHint="@color/muted_text"
                                android:textColor="@color/white"
                                android:textSize="13sp"
                                android:inputType="text"
                                android:maxLines="1"/>

                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <de.hdodenhof.circleimageview.CircleImageView
                        android:id="@+id/profileImage"
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:src="@drawable/person_placeholder_white"
                        app:civ_border_width="2dp"
                        app:civ_border_color="@color/navy_chip"/>

                </LinearLayout>

                <!-- Category Section -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="20dp"
                    android:background="@color/navy_primary">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Browse by"
                        android:textColor="@color/muted_text"
                        android:textSize="11sp"
                        android:textAllCaps="true"
                        android:letterSpacing="0.12"
                        android:layout_marginBottom="14dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="4"
                        android:gravity="center">

                        <!-- Missed Reports -->
                        <LinearLayout
                            android:id="@+id/categoryMissedReports"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="4dp">

                            <androidx.cardview.widget.CardView
                                android:id="@+id/cardMissed"
                                android:layout_width="56dp"
                                android:layout_height="56dp"
                                app:cardCornerRadius="16dp"
                                app:cardElevation="0dp"
                                app:cardBackgroundColor="@color/accent_orange">

                                <ImageView
                                    android:id="@+id/iconMissed"
                                    android:layout_width="26dp"
                                    android:layout_height="26dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_misseed_reports"
                                    app:tint="@color/white"/>
                            </androidx.cardview.widget.CardView>

                            <TextView
                                android:id="@+id/labelMissed"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Missed\nReports"
                                android:textColor="@color/white"
                                android:textSize="9sp"
                                android:gravity="center"
                                android:layout_marginTop="7dp"
                                android:lineSpacingMultiplier="1.2"/>
                        </LinearLayout>

                        <!-- Match Face -->
                        <LinearLayout
                            android:id="@+id/categoryMatchFace"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="4dp">

                            <androidx.cardview.widget.CardView
                                android:id="@+id/cardMatch"
                                android:layout_width="56dp"
                                android:layout_height="56dp"
                                app:cardCornerRadius="16dp"
                                app:cardElevation="0dp"
                                app:cardBackgroundColor="@color/navy_chip">

                                <ImageView
                                    android:id="@+id/iconMatch"
                                    android:layout_width="26dp"
                                    android:layout_height="26dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_face_match"
                                    app:tint="@color/muted_text"/>
                            </androidx.cardview.widget.CardView>

                            <TextView
                                android:id="@+id/labelMatch"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Match\nFace"
                                android:textColor="@color/muted_text"
                                android:textSize="9sp"
                                android:gravity="center"
                                android:layout_marginTop="7dp"
                                android:lineSpacingMultiplier="1.2"/>
                        </LinearLayout>

                        <!-- Your Helps -->
                        <LinearLayout
                            android:id="@+id/categoryYourHelps"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="4dp">

                            <androidx.cardview.widget.CardView
                                android:id="@+id/cardHelp"
                                android:layout_width="56dp"
                                android:layout_height="56dp"
                                app:cardCornerRadius="16dp"
                                app:cardElevation="0dp"
                                app:cardBackgroundColor="@color/navy_chip">

                                <ImageView
                                    android:id="@+id/iconHelp"
                                    android:layout_width="26dp"
                                    android:layout_height="26dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_your_helps"
                                    app:tint="@color/muted_text"/>
                            </androidx.cardview.widget.CardView>

                            <TextView
                                android:id="@+id/labelHelp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Your\nHelps"
                                android:textColor="@color/muted_text"
                                android:textSize="9sp"
                                android:gravity="center"
                                android:layout_marginTop="7dp"
                                android:lineSpacingMultiplier="1.2"/>
                        </LinearLayout>

                        <!-- Achievements -->
                        <LinearLayout
                            android:id="@+id/categoryAchivements"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="4dp">

                            <androidx.cardview.widget.CardView
                                android:id="@+id/cardAchieve"
                                android:layout_width="56dp"
                                android:layout_height="56dp"
                                app:cardCornerRadius="16dp"
                                app:cardElevation="0dp"
                                app:cardBackgroundColor="@color/navy_chip">

                                <ImageView
                                    android:id="@+id/iconAchieve"
                                    android:layout_width="26dp"
                                    android:layout_height="26dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_achievements"
                                    app:tint="@color/muted_text"/>
                            </androidx.cardview.widget.CardView>

                            <TextView
                                android:id="@+id/labelAchieve"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Achieve\nments"
                                android:textColor="@color/muted_text"
                                android:textSize="9sp"
                                android:gravity="center"
                                android:layout_marginTop="7dp"
                                android:lineSpacingMultiplier="1.2"/>
                        </LinearLayout>

                    </LinearLayout>
                </LinearLayout>


                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/surface_bg"
                    android:minHeight="500dp">

                    <FrameLayout
                        android:id="@+id/fragmentContainer"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"/>

                </FrameLayout>

            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Navigation -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:background="@color/white"
        app:elevation="0dp"
        app:itemIconSize="28dp"
        app:itemIconTint="@color/nav_item_color_state"
        app:itemTextColor="@color/nav_text_color_state"
        app:labelVisibilityMode="labeled"
        app:layout_constraintBottom_toBottomOf="parent"
        app:menu="@menu/bottom_nav_menu"
        android:layout_gravity="bottom"
        />

</androidx.coordinatorlayout.widget.CoordinatorLayout>