<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/explore_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A1F3C"
    android:fitsSystemWindows="false">

    <!-- ═══════════════════════════════════════════
         SCROLLABLE CONTENT
    ═══════════════════════════════════════════ -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:layout_marginBottom="72dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:id="@+id/containerLinear"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ═══════════════════════════════════════════
                 NAVY HEADER BLOCK
                 paddingTop handles the status bar height so
                 the header colour bleeds all the way up.
            ═══════════════════════════════════════════ -->
            <LinearLayout
                android:id="@+id/topWhite"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#1A1F3C"
                android:fitsSystemWindows="true">

                <!-- Search Bar + Profile Picture -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="16dp"
                    android:gravity="center_vertical"
                    android:background="#1A1F3C">

                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="12dp"
                        app:cardCornerRadius="25dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="#2A3050">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:src="@drawable/ic_search"
                                android:tint="#8892B8"
                                tools:ignore="UseAppTint"/>

                            <EditText
                                android:id="@+id/searchEditText"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="10dp"
                                android:background="@null"
                                android:hint="Search missing persons…"
                                android:textColorHint="#8892B8"
                                android:textColor="#FFFFFF"
                                android:textSize="13sp"
                                android:inputType="text"
                                android:maxLines="1"/>

                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <de.hdodenhof.circleimageview.CircleImageView
                        android:id="@+id/profileImage"
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:src="@drawable/person_placeholder_white"
                        app:civ_border_width="2dp"
                        app:civ_border_color="#2A3050"/>

                </LinearLayout>

                <!-- Category Section -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="20dp"
                    android:background="#1A1F3C">

                    <TextView
                        android:id="@+id/tvCategory"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Browse by"
                        android:textColor="#8892B8"
                        android:textSize="11sp"
                        android:textAllCaps="true"
                        android:letterSpacing="0.12"
                        android:layout_marginBottom="14dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="4"
                        android:gravity="center">

                        <!-- Missed Reports -->
                        <LinearLayout
                            android:id="@+id/categoryMissedReports"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="4dp">

                            <androidx.cardview.widget.CardView
                                android:id="@+id/cardMissed"
                                android:layout_width="56dp"
                                android:layout_height="56dp"
                                app:cardCornerRadius="16dp"
                                app:cardElevation="0dp"
                                app:cardBackgroundColor="#FF8C42">

                                <ImageView
                                    android:id="@+id/iconMissed"
                                    android:layout_width="26dp"
                                    android:layout_height="26dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_misseed_reports"
                                    app:tint="#FFFFFF"/>
                            </androidx.cardview.widget.CardView>

                            <TextView
                                android:id="@+id/labelMissed"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Missed\nReports"
                                android:textColor="#FFFFFF"
                                android:textSize="9sp"
                                android:gravity="center"
                                android:layout_marginTop="7dp"
                                android:lineSpacingMultiplier="1.2"/>
                        </LinearLayout>

                        <!-- Match Face -->
                        <LinearLayout
                            android:id="@+id/categoryMatchFace"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="4dp">

                            <androidx.cardview.widget.CardView
                                android:id="@+id/cardMatch"
                                android:layout_width="56dp"
                                android:layout_height="56dp"
                                app:cardCornerRadius="16dp"
                                app:cardElevation="0dp"
                                app:cardBackgroundColor="#2A3050">

                                <ImageView
                                    android:id="@+id/iconMatch"
                                    android:layout_width="26dp"
                                    android:layout_height="26dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_face_match"
                                    app:tint="#8892B8"/>
                            </androidx.cardview.widget.CardView>

                            <TextView
                                android:id="@+id/labelMatch"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Match\nFace"
                                android:textColor="#8892B8"
                                android:textSize="9sp"
                                android:gravity="center"
                                android:layout_marginTop="7dp"
                                android:lineSpacingMultiplier="1.2"/>
                        </LinearLayout>

                        <!-- Your Helps -->
                        <LinearLayout
                            android:id="@+id/categoryYourHelps"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="4dp">

                            <androidx.cardview.widget.CardView
                                android:id="@+id/cardHelp"
                                android:layout_width="56dp"
                                android:layout_height="56dp"
                                app:cardCornerRadius="16dp"
                                app:cardElevation="0dp"
                                app:cardBackgroundColor="#2A3050">

                                <ImageView
                                    android:id="@+id/iconHelp"
                                    android:layout_width="26dp"
                                    android:layout_height="26dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_your_helps"
                                    app:tint="#8892B8"/>
                            </androidx.cardview.widget.CardView>

                            <TextView
                                android:id="@+id/labelHelp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Your\nHelps"
                                android:textColor="#8892B8"
                                android:textSize="9sp"
                                android:gravity="center"
                                android:layout_marginTop="7dp"
                                android:lineSpacingMultiplier="1.2"/>
                        </LinearLayout>

                        <!-- Achievements -->
                        <LinearLayout
                            android:id="@+id/categoryAchivements"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="4dp">

                            <androidx.cardview.widget.CardView
                                android:id="@+id/cardAchieve"
                                android:layout_width="56dp"
                                android:layout_height="56dp"
                                app:cardCornerRadius="16dp"
                                app:cardElevation="0dp"
                                app:cardBackgroundColor="#2A3050">

                                <ImageView
                                    android:id="@+id/iconAchieve"
                                    android:layout_width="26dp"
                                    android:layout_height="26dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_achievements"
                                    app:tint="#8892B8"/>
                            </androidx.cardview.widget.CardView>

                            <TextView
                                android:id="@+id/labelAchieve"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Achieve\nments"
                                android:textColor="#8892B8"
                                android:textSize="9sp"
                                android:gravity="center"
                                android:layout_marginTop="7dp"
                                android:lineSpacingMultiplier="1.2"/>
                        </LinearLayout>

                    </LinearLayout>
                </LinearLayout>

                <!-- ═══════════════════════════════════════════
                     FRAGMENT CONTAINER
                     Background #F4F5F9 so fragments sit on
                     the light surface, not the navy header.
                ═══════════════════════════════════════════ -->
                <FrameLayout
                    android:id="@+id/bottomColoredArea"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#F4F5F9"
                    android:minHeight="500dp">

                    <FrameLayout
                        android:id="@+id/fragmentContainer"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"/>

                </FrameLayout>

            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Navigation -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_gravity="bottom"
        android:background="#FFFFFF"
        app:elevation="12dp"
        app:itemIconSize="26dp"
        app:itemIconTint="@color/nav_item_color_state"
        app:itemTextColor="@color/nav_item_color_state"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav_menu"/>

</androidx.coordinatorlayout.widget.CoordinatorLayout>