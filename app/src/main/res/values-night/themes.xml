<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme (Always Light — keeps your original intent) -->
    <style name="Base.Theme.Hoppeconnect" parent="Theme.Material3.Light.NoActionBar">

        <item name="colorPrimary">@color/brand_primary</item>

        <!-- Correct background -->
        <item name="android:colorBackground">@color/bg_primary</item>

        <!-- ── Status bar: navy instead of purple/blue ── -->
        <item name="android:statusBarColor">@color/navy_primary</item>
        <!-- Night theme has a dark background so white icons are fine -->
        <item name="android:windowLightStatusBar" tools:targetApi="23">false</item>
        <item name="android:navigationBarColor">@color/white</item>

    </style>

</resources>